{
    "name": "farmwell-production",
    "main": "cloudflare-worker.js",
    "compatibility_date": "2026-11-01",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "app.farmwell.app", "custom_domain": true },
        { "pattern": "pilot.farmwell.app", "custom_domain": true }
    ],
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "40344948b73fa9da3008958fdc3faf12",
        "REHEARSAL_MODE": "false",
        "STARTUP_TIMING_ENABLED": "true",
        "APP_NAME": "Farmwell",
        "MAIL_FROM_ADDRESS": "noreply@mail.farmwell.app",
        "SESSION_COOKIE": "farmwell_production_session",
        "PHONE_PILOT_HOST": "app.farmwell.app",
        "PHONE_PILOT_SMS_DAILY_LIMIT": "10",
        "APP_URL": "https://app.farmwell.app",
        "AWS_ENDPOINT": "https://40344948b73fa9da3008958fdc3faf12.r2.cloudflarestorage.com",
        "AWS_BUCKET": "farmwell-production-live-private",
        "PHONE_PILOT_FULL_WORKSPACE": "true",
        "REDIRECT_HOST": "pilot.farmwell.app",
        "PHONE_LOGIN_ENABLED": "true",
        "PHONE_PILOT_NIGERIA_OTP_PROVIDER": "kudisms",
        "KUDISMS_SENDER_ID": "Farmwell",
        "KUDISMS_OTP_APP_CODE": "8490844367",
        "KUDISMS_OTP_TEMPLATE_CODE": "81666357"
    },
    "observability": { "enabled": true },
    "tail_consumers": [
        {
            "service": "farmwell-production-alerts"
        }
    ],
    "triggers": {
        "crons": ["* * * * *"]
    },
    "containers": [
        {
            "class_name": "FarmwellWeb",
            "scheduling_policy": "durable_object",
            "images": {
                "base": {
                    "dockerfile": "./Dockerfile"
                }
            }
        },
        {
            "class_name": "FarmwellQueue",
            "scheduling_policy": "durable_object",
            "images": {
                "base": {
                    "dockerfile": "./Dockerfile"
                }
            }
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "FARMWELL_WEB",
                "class_name": "FarmwellWeb"
            },
            {
                "name": "FARMWELL_QUEUE",
                "class_name": "FarmwellQueue"
            }
        ]
    },
    "exports": {
        "FarmwellWeb": {
            "type": "durable-object",
            "storage": "sqlite"
        },
        "FarmwellQueue": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    }
}
