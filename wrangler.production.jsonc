{
    "name": "farmwell-production",
    "main": "cloudflare-worker.js",
    "compatibility_date": "2026-11-01",
    "workers_dev": false,
    "preview_urls": false,
    "routes": [
        { "pattern": "production-preview.farmwell.app", "custom_domain": true }
    ],
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "40344948b73fa9da3008958fdc3faf12",
        "REHEARSAL_MODE": "true",
        "STARTUP_TIMING_ENABLED": "true",
        "APP_NAME": "Farmwell Production Rehearsal",
        "MAIL_FROM_ADDRESS": "noreply@mail.farmwell.app",
        "SESSION_COOKIE": "farmwell_production_session",
        "PHONE_PILOT_HOST": "",
        "PHONE_PILOT_SMS_DAILY_LIMIT": "10",
        "APP_URL": "https://production-preview.farmwell.app",
        "AWS_ENDPOINT": "https://40344948b73fa9da3008958fdc3faf12.r2.cloudflarestorage.com",
        "AWS_BUCKET": "farmwell-production-private",
    },
    "observability": { "enabled": true },
    "tail_consumers": [{ "service": "farmwell-production-alerts" }],
    "triggers": { "crons": [] },
    "containers": [
        {
            "class_name": "FarmwellWeb",
            "scheduling_policy": "durable_object",
            "images": { "base": { "dockerfile": "./Dockerfile" } },
        },
        {
            "class_name": "FarmwellQueue",
            "scheduling_policy": "durable_object",
            "images": { "base": { "dockerfile": "./Dockerfile" } },
        },
    ],
    "durable_objects": {
        "bindings": [
            { "name": "FARMWELL_WEB", "class_name": "FarmwellWeb" },
            { "name": "FARMWELL_QUEUE", "class_name": "FarmwellQueue" },
        ],
    },
    "exports": {
        "FarmwellWeb": { "type": "durable-object", "storage": "sqlite" },
        "FarmwellQueue": { "type": "durable-object", "storage": "sqlite" },
    },
}
